{
  "contract_id": "park-paper-runtime-v1",
  "execution_track": "park",
  "paper_only": true,
  "authoritative_adapter": "nautilus_paper_direct",
  "paper_preflight": {
    "schema": "park-paper-preflight-v1",
    "required": true,
    "source_bound": true,
    "credential_free": true,
    "fee_mode": "paper_contract",
    "instrument_and_fee_fields_must_be_explicit": true,
    "legacy_shadow_cutover_receipt": "not_required"
  },
  "strategy_identity": ["strategy_session_id", "strategy_revision_id", "plan_digest"],
  "recording_window": {
    "timezone": "Asia/Shanghai",
    "boundaries": ["09:00", "21:00"],
    "effects": ["package", "review"],
    "forbidden_effects": ["strategy_switch", "replan", "cancel_orders", "flatten_positions"]
  },
  "confirmation": {
    "required": true,
    "exact_digest": true,
    "pre_confirmation_mutations": false
  },
  "mutation_authority": {
    "runtime_capability": "opaque_runtime_minted",
    "caller_supplied_strings_or_mappings": false,
    "command_identity_binding": ["strategy_session_id", "strategy_revision_id", "plan_digest"],
    "manual_adapter_construction": "fail_closed",
    "missing_capability": "fail_closed"
  },
  "boundary_invalidation": {
    "trigger": "touch_or_cross_upper_or_lower_boundary",
    "actions": ["freeze_new_entries", "cancel_owned_unfilled_entries", "close_owned_positions", "reconcile", "persist_closure", "pause", "notify_park"],
    "automatic_reopen": false,
    "automatic_reverse": false,
    "automatic_flatten_without_explicit_boundary_or_stop_or_target": false
  },
  "safety": {
    "required_cutover_gates": [
      "trusted_market",
      "tick_freshness",
      "stale_cycle_state",
      "reconciliation",
      "immutable_fill",
      "park_risk_confirmation",
      "paper_only",
      "release_sha_ownership",
      "boot",
      "supervisor_fail_closed"
    ],
    "missing_evidence": "fail_closed"
  },
  "forbidden": [
    "legacy_cycle_runner",
    "legacy_stop_flatten",
    "paper_auto_approve",
    "shadow_mutation",
    "feishu_control",
    "live_execution"
  ]
}
