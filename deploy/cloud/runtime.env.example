# Non-secret Cloud Paper path and loopback contract.
TRADING_ORCHESTRATOR_OUTPUT_ROOT=/var/lib/gridmind/outputs
TRADING_ORCHESTRATOR_MARKET_DB=/var/lib/gridmind/market_data.db
TRADING_ORCHESTRATOR_LIVE_ENV=/etc/gridmind/paper.env
TRADING_ORCHESTRATOR_DATAFEED_URL=http://127.0.0.1:8100
TRADING_ORCHESTRATOR_DASHBOARD_URL=http://127.0.0.1:8765
TRADING_ORCHESTRATOR_NAUTILUS_PYTHON=/opt/gridmind/venvs/nautilus/bin/python
KLINE_DB_PATH=/var/lib/gridmind/datafeed/kline.db
KLINE_PORT=8100
GRIDMIND_SCHEDULER_OWNER_ID=cloud-primary
GRIDMIND_BACKUP_ROOT=/var/lib/gridmind/backups
GRIDMIND_BACKUP_ENCRYPTION_MODE=provider_volume_at_rest
GOLDBOT_UPSTREAM=http://127.0.0.1:8765
GOLDBOT_ACCESS_AUDIT_PATH=/var/lib/gridmind/outputs/cloud/access/audit.jsonl
GOLDBOT_ACCESS_SESSION_DURATION=168h
# The Cloudflare Access team domain, application AUD and allowed email belong
# in /etc/gridmind/paper.env, never in this tracked non-secret path file.
