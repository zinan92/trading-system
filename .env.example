# Copy to .env and `set -a; source .env; set +a` (scripts/run-*.sh do this for you).
# Nothing in this file is a secret. Secrets live in files with mode 0600 (see README "Secrets").

# ---- Shared -------------------------------------------------------------
# Where every receipt, ledger, read model and boot gate lands. Default: <repo>/outputs
TRADING_ORCHESTRATOR_OUTPUT_ROOT=./outputs
# Local SQLite market store. Default: <repo>/data/market_data.db
TRADING_ORCHESTRATOR_MARKET_DB=./data/market_data.db
TZ=UTC
PYTHONUNBUFFERED=1

# ---- Dashboard / GridMind (python3 -m pipelines.dashboard_server) --------
# Hyperliquid Testnet identity the dashboard reads (public address only; read-only without a key).
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=
HYPERLIQUID_TESTNET_INSTRUMENT_ID=BTC-USD-PERP
HYPERLIQUID_TESTNET_PROTECTION_PROFILE=hyperliquid-testnet-position-protection
HYPERLIQUID_TESTNET_MAX_ORACLE_DEVIATION_BPS=100
# 0600 file holding the Testnet private key. Leave empty for read-only browsing.
HYPERLIQUID_TESTNET_SECRET_FILE=
# Python that has nautilus_trader installed (only for Testnet execution / paper ledger).
TRADING_ORCHESTRATOR_NAUTILUS_PYTHON=./.venv-nautilus/bin/python
TRADING_ORCHESTRATOR_NAUTILUS_PAPER_SWITCH_APPROVED=0
# Park's strategy track config (copy configs/park_strategy_track.json and edit).
TRADING_ORCHESTRATOR_PARK_CONFIG=./configs/park_strategy_track.json

# ---- 交易台 trading-desk (python3 -m trading_desk serve) -----------------
TRADING_DESK_PORT=8790
TRADING_DESK_DASHBOARD_URL=http://127.0.0.1:8765
# Optional news rail. Any HTTP service that answers /api/news like zinan92/intel; leave as is if you have none.
TRADING_DESK_INTEL_URL=http://127.0.0.1:8001
TRADING_DESK_HL_INFO_URL=https://api.hyperliquid-testnet.xyz/info
TRADING_DESK_HL_ACCOUNT=
# Desk state (judgments, plans, notes). Default: ~/park-data/trading-desk/desk.db
TRADING_DESK_DB=
# 0600 file with the passcode required when the desk is reached through a tunnel. Local requests never need it.
TRADING_DESK_REMOTE_PASSCODE=
# Optional newsletter inputs shown on /desk#news; the page degrades gracefully when they are absent.
TRADING_DESK_MORNING_LATEST=
TRADING_DESK_KLINE_HTML=
TRADING_DESK_WEEKLY_HTML=

# ---- Alerts (optional, see configs/live.env.template for the full list) --
TRADING_ORCHESTRATOR_ALERT_CHANNEL=auto
