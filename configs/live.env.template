# Copy this file to configs/live.env and fill in real values locally.
# configs/live.env is ignored and should not be committed or shared.

# Tiger OpenAPI: keep the RSA/license properties file outside git and point to it.
TIGER_OPENAPI_CONFIG_PATH=/absolute/path/to/tiger_openapi_config.properties

OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# Binance USDM futures. Required only when broker.provider=binance_usdm
# and dry_run=false. Keep permissions at 600.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram alert delivery. Required for M5 "主动叫你" / phone push proof.
TRADING_ORCHESTRATOR_TELEGRAM_BOT_TOKEN=
TRADING_ORCHESTRATOR_TELEGRAM_CHAT_ID=

# Alert delivery channel. Supported: auto, feishu, telegram.
TRADING_ORCHESTRATOR_ALERT_CHANNEL=auto

# Feishu/Lark alert delivery. Recommended replacement for Telegram if Telegram
# is unavailable. Keep the webhook URL and optional signing secret local only.
TRADING_ORCHESTRATOR_FEISHU_WEBHOOK_URL=
TRADING_ORCHESTRATOR_FEISHU_SECRET=

# Optional separate Feishu/Lark delivery for PM reports, strategy research, and
# market-analysis prompts. If unset, reports fall back to the alert webhook.
TRADING_ORCHESTRATOR_REPORT_FEISHU_WEBHOOK_URL=
TRADING_ORCHESTRATOR_REPORT_FEISHU_SECRET=

# Optional dedicated Feishu/Lark channel for executed trade-record cards
# (the gold 开单审查卡). If unset, trade cards fall back to the report webhook,
# then the alert webhook. Keep the URL and signing secret local only.
TRADING_ORCHESTRATOR_TRADE_FEISHU_WEBHOOK_URL=
TRADING_ORCHESTRATOR_TRADE_FEISHU_SECRET=

# Optional Obsidian vault root. Market-view notes are written under:
# 003_park原始输出/每日交易分析
TRADING_ORCHESTRATOR_OBSIDIAN_ROOT=

# Optional overrides:
# TRADING_ORCHESTRATOR_GOLD_PRICE=
# TRADING_ORCHESTRATOR_GOLD_TIMESTAMP=

# External dead-man switch. These URLs are effectively secrets because anyone
# with the URL can mark the check healthy/failing.
TRADING_ORCHESTRATOR_DEADMAN_URL=
TRADING_ORCHESTRATOR_DEADMAN_POSITION_URL=
